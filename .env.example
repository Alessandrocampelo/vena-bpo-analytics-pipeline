# Copie para .env e preencha os valores reais. .env nunca é versionado (ver .gitignore).

# Fonte 1 — API de vendas
VENA_API_BASE_URL=https://api-vendas-teste-vyi7ppqsoq-rj.a.run.app
VENA_API_TOKEN=vena-teste-2026

# Fonte 2 — Scraping de concorrentes
SCRAPING_BASE_URL=https://scraping-precos-teste-vyi7ppqsoq-rj.a.run.app

# Fonte 3 — Banco transacional (caminho absoluto para o .sqlite recebido no teste)
SQLITE_DB_PATH=/caminho/para/banco_transacional.sqlite

# Destino GCP
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/sa-candidato-ae.json
GCS_BUCKET_NAME=vena-teste-candidato-ae
BQ_PROJECT_ID=vena-teste
BQ_DATASET=teste_tecnico_ae

# Ingestão — tunáveis de resiliência (ADR-006)
API_MAX_CONCURRENCY=8
API_MAX_RETRIES=6
SQLITE_CHUNK_SIZE=50000

# Só para demonstrar deliberadamente o retry policy/alerta do asset de
# scraping (ADR-006) — nunca usar "true" em produção.
FORCE_UNKNOWN_LAYOUT=false
