# Copie para dbt/profiles.yml (não versionado, ver .gitignore) e rode
# `dbt` sempre com as mesmas variáveis de ambiente do .env carregadas no
# shell (dbt não lê .env sozinho como o python-dotenv faz para a
# ingestão) — ex.: `set -a && source ../.env && set +a` antes de `dbt ...`.
vena_bpo_analytics:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{ env_var('BQ_PROJECT_ID') }}"
      dataset: "{{ env_var('BQ_DATASET') }}"
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS') }}"
      location: southamerica-east1
      threads: 4
      priority: interactive
      job_execution_timeout_seconds: 300
